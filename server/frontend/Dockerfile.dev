# syntax=docker/dockerfile:1.7
# Dev-mode Next.js -- source baked in, next dev runs on start. Self-contained
# (context: this directory). Mount named volumes over node_modules and .next
# to keep them across restarts.

FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=development
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV S3_BACKEND_URL=http://backend:9000

COPY . .

EXPOSE 3000
CMD ["npx", "next", "dev"]
